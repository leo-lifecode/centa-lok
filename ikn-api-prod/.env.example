# Database: Supabase (PostgreSQL). Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit .env (sudah ada di .gitignore). Isi di bawah ini hanya contoh format.
# Ambil connection string dari Supabase Dashboard > Connect > "Session pooler" (port 5432).
# Session pooler dipakai karena backend NestJS berjalan terus (bukan serverless),
# dan string yang sama bisa dipakai untuk aplikasi maupun `prisma migrate`.
# Jika memakai koneksi langsung (IPv6 / IPv4 add-on): db.[PROJECT-REF].supabase.co:5432
DATABASE_URL_LOCAL = postgresql://postgres.[PROJECT-REF]:[DB-PASSWORD]@[POOLER-HOST]:5432/postgres

# Buat secret acak, contoh: openssl rand -base64 48 (JWT_SECRET dan JWT_REFRESH_SECRET harus berbeda)
JWT_SECRET=
JWT_EXPIRES_IN="5h"
JWT_EXPIRES_RERESh_TOKEN="1d"
PORT= 3000
JWT_REFRESH_SECRET = 

B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
FRONTEND_SHARED_SECRET = 
RECAPTCHA_SECRET_KEY = 
DOMAIN_CAPTCHA = 
DOMAIN_ORIGIN = http://localhost:5173

# bot
TELEGRAM_ERROR_NOTIF_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ERROR_NOTIF_4XX=true
SERVICE_LOG_SUCCESS_ENABLED=false