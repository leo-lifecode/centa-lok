generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_LOCAL")
}

model User {
  id                       String                     @id @default(uuid())
  name                     String                     @unique
  email                    String                     @unique
  password                 String
  nik                      String
  jabatan                  String
  refreshToken             String?
  createdAt                DateTime                   @default(now())
  deletedAt                DateTime?
  isPusat                  Boolean                    @default(false)
  unitId                   String
  isRoot                   IsRoot                     @default(N)
  account                  Account[]
  approvedRequests         ApprovalRequest[]          @relation("ApprovedByUser")
  createdRequests          ApprovalRequest[]          @relation("CreatedByUser")
  bankAccount              BankAccount[]
  cashBankTransaction      CashBankTransaction[]
  cashFlow                 CashFlow[]
  contracts                Contract[]                 @relation("SignedContracts")
  customer                 Customer[]
  deliveryOrder            DeliveryOrder[]
  generalLedger            GeneralLedger[]
  invoice                  Invoice[]
  invoiceEkspor            InvoiceEkspor[]
  journalEntry             JournalEntry[]
  masterBarangJadi         MasterBarangJadi[]
  masterKategoriBarangJadi MasterKategoriBarangJadi[]
  masterSatuan             MasterSatuan[]
  openingBalance           OpeningBalance[]
  openingBalanceHeader     OpeningBalanceHeader[]
  OpeningBankDetails       OpeningBankDetails[]
  payrolls                 Payroll[]
  ProductionIssue          ProductionIssue[]
  productionReceipt        ProductionReceipt[]
  PurchaseOrder            PurchaseOrder[]
  sPB                      SPB[]
  SalesPlan                SalesPlan[]
  StockRequest             StockRequest[]
  tax                      Tax[]
  taxes                    Tax[]                      @relation("UserTax")
  TaxReport                TaxReport[]
  unit                     MasterUnit                 @relation(fields: [unitId], references: [id])
  ServiceLog               ServiceLog[]
  roles                    UserRole[]
}

model ServiceLog {
  id           String    @id @default(uuid())
  status       LogStatus
  action       String
  actorName    String
  actorId      String?
  moduleName   String?
  method       String
  url          String
  httpStatus   Int
  durationMs   Int
  ip           String?
  userAgent    String?
  requestBody  Json?
  responseBody Json?
  errorDetail  String?
  errorStack   String?
  metadata     Json?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?
  actor        User?     @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([actorId])
  @@index([moduleName])
  @@map("service_logs")
}

model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  permissions RolePermission[]
  users       UserRole[]
}

model UserRole {
  userId    String
  roleId    Int
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Menu {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  path        String           @unique
  icon        String?
  createdAt   DateTime         @default(now())
  deletedAt   DateTime?
  nameParent  String?
  parentId    Int?
  parent      Menu?            @relation("MenuToSubmenu", fields: [parentId], references: [id])
  children    Menu[]           @relation("MenuToSubmenu")
  permissions RolePermission[]
}

model RolePermission {
  roleId     Int
  menuId     Int
  canView    Boolean   @default(false)
  canAdd     Boolean   @default(false)
  canEdit    Boolean   @default(false)
  canDelete  Boolean   @default(false)
  canApprove Boolean   @default(false)
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  menu       Menu      @relation(fields: [menuId], references: [id])
  role       Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, menuId])
  @@map("role_permissions")
}

model Customer {
  id            String          @id @default(uuid())
  code          String
  name          String
  address       String
  unit          String
  email         String?
  phone         String?
  country       String?
  continent     String?
  regional_type String
  fax           String?
  staffId       String
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  staff         User            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  invoiceEkspor InvoiceEkspor[]
  purchaseOrder PurchaseOrder[]
}

model InvoiceTax {
  id                 String   @id @default(uuid())
  invoiceId          String
  taxId              String
  taxType            String
  taxValue           Float
  withheldByCustomer Boolean
  isIncludedInPrice  Boolean
  taxAmount          Float
  createdAt          DateTime @default(now())
  invoice            Invoice  @relation(fields: [invoiceId], references: [id])
  tax                Tax      @relation(fields: [taxId], references: [id])

  @@unique([invoiceId, taxId])
}

model Tax {
  id               String             @id @default(uuid())
  taxType          String
  taxValue         Float
  verifiedById     String?
  status           String
  createdAt        DateTime           @default(now())
  invoiceId        String?
  type             TypeTax
  isActive         Boolean
  staffId          String
  accountCode      String             @unique
  deletedAt        DateTime?
  namaAccount      String
  InvoiceTax       InvoiceTax[]
  PurchaseOrderTax PurchaseOrderTax[]
  SPBTax           SPBTax[]
  account          Account            @relation(fields: [accountCode], references: [code], onDelete: Cascade)
  invoice          Invoice?           @relation(fields: [invoiceId], references: [id])
  staff            User               @relation(fields: [staffId], references: [id], onDelete: Cascade)
  verifiedBy       User?              @relation("UserTax", fields: [verifiedById], references: [id])
}

model TaxTypeMap {
  id        String    @id @default(uuid())
  name      String
  code      String    @unique
  rate      Float
  position  Position
  usage     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Contract {
  id              String         @id @default(uuid())
  purchaseOrderId String?        @unique
  deliveryOrderId String?        @unique
  fileUrl         String
  signedById      String?
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id], onDelete: Cascade)
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  signedBy        User?          @relation("SignedContracts", fields: [signedById], references: [id])
  invoice         Invoice?
}

model Finance {
  id              String         @id @default(uuid())
  purchaseOrderId String?        @unique
  amount          Float
  accountCode     String
  status          StatusFinance
  deletedAt       DateTime?
  createdAt       DateTime       @default(now())
  account         Account        @relation(fields: [accountCode], references: [code])
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model BankAccount {
  id                   String                @id @default(uuid())
  accountCode          String
  bankName             String
  bankCode             String?               @default("BRIV")
  currency             String
  branchAddress        String
  currencyRate         Decimal               @default(0)
  bankAccountNumber    String
  initialBalance       Float                 @default(0)
  currentBalance       Float                 @default(0)
  staffId              String
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  deletedAt            DateTime?
  date                 DateTime
  unitId               String
  period               String?
  isPosted             String                @default("Y")
  currentBalanceDollar Float?
  account              Account               @relation(fields: [accountCode], references: [code])
  staff                User                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit                 MasterUnit            @relation(fields: [unitId], references: [id])
  CashBankTransaction  CashBankTransaction[]
  Invoice              Invoice[]
  OpeningBankDetails   OpeningBankDetails[]

  @@unique([unitId, accountCode, period], name: "unit_accountCode_periode")
}

model OpeningBankDetails {
  id          String      @id @default(uuid())
  headerId    String
  unitId      String
  accountCode String
  staffId     String
  debit       Float       @default(0)
  credit      Float       @default(0)
  fiscalYear  String
  deletedAt   DateTime?
  createdAt   DateTime?
  account     Account     @relation(fields: [accountCode], references: [code])
  header      BankAccount @relation(fields: [headerId], references: [id])
  staff       User        @relation(fields: [staffId], references: [id])
  unit        MasterUnit  @relation(fields: [unitId], references: [id])

  @@unique([accountCode, headerId])
}

model AccountType {
  id            String        @id @default(uuid())
  name          String        @unique
  code          String        @unique
  normalBalance NormalBalance
  description   String?
  deletedAt     DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  accounts      Account[]
}

model Account {
  id                         String                       @id @default(uuid())
  code                       String                       @unique
  name                       String
  parentName                 String?
  accountTypeId              String
  parentId                   String?
  isLocked                   Islocked                     @default(N)
  typeNeraca                 String
  deletedAt                  DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  staffId                    String
  accountType                AccountType                  @relation(fields: [accountTypeId], references: [id])
  parent                     Account?                     @relation("AccountHierarchy", fields: [parentId], references: [code])
  children                   Account[]                    @relation("AccountHierarchy")
  staff                      User                         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  AccountMapping             AccountMapping[]
  bankAccount                BankAccount[]
  budgets                    Budget[]
  CashBankTransaction        CashBankTransaction[]
  cashBankTransactionDetails CashBankTransactionDetails[]
  cashFlow                   CashFlow[]
  finance                    Finance[]
  ledgers                    GeneralLedger[]
  journalDetails             JournalEntryDetail[]
  masterAcitva               MasterAcitva[]
  masterRawMaterials         MasterRawMaterial[]
  masterRekananBahanBaku     MasterRekananBahanBaku[]
  OpeningBalance             OpeningBalance[]
  OpeningBankDetails         OpeningBankDetails[]
  purchaseOrderTax           PurchaseOrderTax[]
  SPBTax                     SPBTax[]
  tax                        Tax?
}

model GeneralLedger {
  id            String     @id @default(uuid())
  accountCode   String
  period        String
  debitTotal    Decimal
  creditTotal   Decimal
  openingDebit  Decimal
  openingCredit Decimal
  createdAt     DateTime   @default(now())
  unitId        String
  staffId       String
  deletedAt     DateTime?
  account       Account    @relation(fields: [accountCode], references: [code])
  staff         User       @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit          MasterUnit @relation(fields: [unitId], references: [id])

  @@unique([unitId, accountCode, period], name: "unit_accountCode_periode")
}

model AccountingPeriod {
  period    String    @id
  isLocked  Boolean   @default(false)
  lockedAt  DateTime?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}

model CashFlow {
  id          String    @id @default(uuid())
  accountCode String
  amount      Float
  staffId     String
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  account     Account   @relation(fields: [accountCode], references: [code], onDelete: Cascade)
  staff       User      @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

model Payroll {
  id        String    @id @default(uuid())
  userId    String
  salary    Float
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Budget {
  id          String     @id @default(uuid())
  year        Int
  month       Int
  accountCode String
  unitId      String
  amount      Decimal    @db.Decimal(15, 2)
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  account     Account    @relation(fields: [accountCode], references: [code])
  unit        MasterUnit @relation(fields: [unitId], references: [id])

  @@unique([year, month, accountCode, unitId], name: "unique_budget")
}

model Journal {
  id          String         @id @default(uuid())
  date        DateTime       @default(now())
  description String
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  entries     JournalEntry[]
}

model AdditionalCharges {
  id              String        @id @default(uuid())
  purchaseOrderId String
  amount          Float
  description     String
  type            String
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
}

model PurchaseOrder {
  id                     String              @id @default(uuid())
  customerId             String
  staffId                String
  orderNumber            String              @unique
  date                   DateTime
  description            String?
  franco                 String
  fileUrl                String?
  fileUrlKontrak         String?
  fileUrlEkspor          String?
  fileUrlProduksi        String?
  fileUrlBl              String?
  subtotalAmount         Float
  approvedFile           String?
  customerName           String
  incoterms              Incoterms           @default(null)
  status                 PurchaseOrderStatus @default(WAITING)
  typePo                 TypePenjualan?      @default(null)
  typePayment            TypePayment         @default(FULLPAYMENT_AFTER_INVOICE)
  downPayment            Decimal             @default(0)
  currency               CurrencyType        @default(RUPIAH)
  unitId                 String
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  postedAt               DateTime?
  deletedAt              DateTime?
  fileUrlSigned          String?
  selectionStatus        SelectionStatus     @default(NOT_SELECTED)
  selectionStatusInvoice SelectionStatus     @default(NOT_SELECTED)
  taxAmount              Decimal             @default(0)
  totalAmount            Decimal             @default(0)
  cekPajak               CekPajak            @default(NO)
  kebun                  String?
  invoiceSelectionStatus SelectionStatus?
  au58s                  AU58[]
  additionalCharges      AdditionalCharges[]
  Contract               Contract?
  DeliveryOrder          DeliveryOrder[]
  Finance                Finance?
  customer               Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  staff                  User                @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit                   MasterUnit          @relation(fields: [unitId], references: [id])
  items                  PurchaseOrderItem[]
  PurchaseOrderTax       PurchaseOrderTax[]
  Receivable             Receivable?
  spbs                   SPB[]
}

model PurchaseOrderItem {
  id                       String                @id @default(uuid())
  purchaseOrderId          String
  quantity                 Float?
  orderNumber              String?
  orderDate                DateTime?
  total                    Float
  stockProduct             Float
  priceProduct             Float
  kodeBarangProduct        String
  namabarangProduct        String
  namabarangProductInvoice String
  spesifikasiProduct       String
  beratproduct             Float
  kategoriProduct          String
  satuanProduct            String
  unitPrice                Decimal               @default(0)
  unitProduct              String
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  deletedAt                DateTime?
  productId                String
  DeliveryOrderDetail      DeliveryOrderDetail[]
  product                  MasterBarangJadi      @relation(fields: [productId], references: [id])
  purchaseOrder            PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id])
}

model PurchaseOrderTax {
  id              String         @id @default(uuid())
  purchaseOrderId String
  taxId           String
  taxType         String
  taxValue        Float
  taxAmount       Float
  accountCode     String?
  createdAt       DateTime       @default(now())
  deletedAt       DateTime?
  journalEntry    JournalEntry[]
  account         Account?       @relation(fields: [accountCode], references: [code])
  purchaseOrder   PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  tax             Tax            @relation(fields: [taxId], references: [id])

  @@unique([purchaseOrderId, taxId])
}

model JournalEntry {
  id                          String                        @id @default(uuid())
  spbId                       String?
  numberJurnal                String?                       @unique
  module                      String
  rawMaterialIssueId          String?
  rawMaterialReceiptId        String?
  transactionId               String?
  description                 String
  referenceNumber             String?
  isPosted                    Boolean                       @default(false)
  createdBy                   String
  date                        DateTime                      @default(now())
  currencyValue               Decimal                       @default(0)
  unitId                      String
  deletedAt                   DateTime?
  journalId                   String?
  createdAt                   DateTime                      @default(now())
  typeJournalEntry            TypePenjualan?                @default(null)
  status                      JournalEntryStatus            @default(DRAFT)
  is_intercompany             Boolean                       @default(false)
  intercompanyReference       String?
  purchaseOrderTaxId          String?
  sPBTaxId                    String?
  currency                    CurrencyType                  @default(RUPIAH)
  staffId                     String
  totalBalance                Decimal?
  totalBalanceUs              Decimal?
  isRevert                    Revert                        @default(N)
  isRevertOpen                Boolean                       @default(false)
  journalEntryId              String?
  purposeTransaction          String?
  addjust                     Boolean                       @default(false)
  JournalAdjustmentSuggestion JournalAdjustmentSuggestion[]
  intercompanyJournal         JournalEntry?                 @relation("IntercompanyJournal", fields: [intercompanyReference], references: [numberJurnal])
  relatedIntercompanies       JournalEntry[]                @relation("IntercompanyJournal")
  Journal                     Journal?                      @relation(fields: [journalId], references: [id])
  PurchaseOrderTax            PurchaseOrderTax?             @relation(fields: [purchaseOrderTaxId], references: [id])
  transactionIssueId          RawMaterialIssue?             @relation(fields: [rawMaterialIssueId], references: [id])
  transactionReceiptId        RawMaterialReceipt?           @relation(fields: [rawMaterialReceiptId], references: [id])
  SPBTax                      SPBTax?                       @relation(fields: [sPBTaxId], references: [id])
  spb                         SPB?                          @relation(fields: [spbId], references: [id])
  staff                       User                          @relation(fields: [staffId], references: [id], onDelete: Cascade)
  transaction                 CashBankTransaction?          @relation(fields: [transactionId], references: [id])
  unit                        MasterUnit                    @relation(fields: [unitId], references: [id])
  details                     JournalEntryDetail[]

  @@index([transactionId])
  @@index([spbId])
}

model JournalEntryDetail {
  id             String       @id @default(uuid())
  journalEntryId String
  unitId         String?
  fixedAssetId   String?
  accountCode    String
  debit          Decimal      @default(0)
  credit         Decimal      @default(0)
  isTmp          Boolean      @default(false)
  debitDollar    Decimal      @default(0)
  creditDollar   Decimal      @default(0)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  description    String?
  account        Account      @relation(fields: [accountCode], references: [code])
  fixedAsset     FixedAsset?  @relation("FixedAssetJournalDetails", fields: [fixedAssetId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  unit           MasterUnit?  @relation(fields: [unitId], references: [id])
}

model Receivable {
  id              String        @id @default(uuid())
  purchaseOrderId String        @unique
  amount          Float
  dueDate         DateTime
  status          String
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
}

model Payable {
  id        String    @id @default(uuid())
  vendor    String
  amount    Float
  dueDate   DateTime
  status    String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
}

model CashBankTransaction {
  id                         String                       @id @default(uuid())
  transactionNumber          String                       @unique
  amountOriginal             Float
  amountInIDR                Float
  currency                   String
  exchangeRate               Decimal                      @default(0)
  accounIdTax                String?
  grossAmount                Decimal                      @default(0)
  administrasiAmount         Decimal                      @default(0)
  type                       TransactionType
  description                String
  date                       DateTime                     @default(now())
  kategori                   String?
  to                         String?
  address                    String?
  isMaterial                 String                       @default("N")
  taxType                    String?
  taxValue                   Decimal                      @default(0)
  taxAmount                  Decimal                      @default(0)
  unitId                     String
  accountCode                String?
  invoiceId                  String?
  invoiceEksporId            String?
  bank_account_id            String?
  staffId                    String
  typeTransaction            TypePenjualan?               @default(null)
  deletedAt                  DateTime?
  createdAt                  DateTime                     @default(now())
  isActionEnabled            Boolean                      @default(false)
  receivedFrom               String?
  purpose                    String?
  materialId                 String?
  account                    Account?                     @relation(fields: [accountCode], references: [code])
  bank_account               BankAccount?                 @relation(fields: [bank_account_id], references: [id])
  invoiceEkspor              InvoiceEkspor?               @relation(fields: [invoiceEksporId], references: [id])
  invoice                    Invoice?                     @relation(fields: [invoiceId], references: [id])
  staff                      User                         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit                       MasterUnit                   @relation(fields: [unitId], references: [id])
  cashBankTransactionDetails CashBankTransactionDetails[]
  journalEntry               JournalEntry[]
  withholdingTaxes           WithholdingTax[]

  @@index([materialId])
}

model CashBankTransactionDetails {
  id                    String              @id @default(uuid())
  cashBankTransactionId String
  keterangan            String
  unitId                String?
  accountCode           String
  accountName           String
  debit                 Decimal             @default(0)
  credit                Decimal             @default(0)
  deletedAt             DateTime?
  createdAt             DateTime            @default(now())
  account               Account             @relation(fields: [accountCode], references: [code])
  CashBankTransaction   CashBankTransaction @relation(fields: [cashBankTransactionId], references: [id])
  unit                  MasterUnit?         @relation(fields: [unitId], references: [id])
}

model WithholdingTax {
  id            String              @id @default(uuid())
  transactionId String
  type          TaxType
  amount        Float
  createdAt     DateTime            @default(now())
  transaction   CashBankTransaction @relation(fields: [transactionId], references: [id])
}

model SalesPlan {
  id            String          @id @default(uuid())
  staffId       String
  date          DateTime        @default(now())
  description   String
  value_rkap    Decimal
  unitId        String
  periode_month String
  status        SalesPlanStatus @default(PENDING)
  typeSalesPlan TypePenjualan?  @default(null)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  staff         User            @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit          MasterUnit      @relation(fields: [unitId], references: [id])
}

model TaxReport {
  id           String    @id @default(uuid())
  month        String
  taxAmount    Float
  verifiedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  verifiedBy   User?     @relation(fields: [verifiedById], references: [id])
}

model ApprovalRequest {
  id               String            @id @default(uuid())
  requestType      ApprovalType
  referenceId      String
  createdById      String
  approvedById     String?
  status           ApprovalStatus    @default(PENDING)
  createdAt        DateTime          @default(now())
  approvedAt       DateTime?
  deletedAt        DateTime?
  ApprovalDocument ApprovalDocument?
  approvedBy       User?             @relation("ApprovedByUser", fields: [approvedById], references: [id])
  createdBy        User              @relation("CreatedByUser", fields: [createdById], references: [id])
}

model DeliveryOrder {
  id                  String                @id @default(uuid())
  purchaseOrderId     String
  au58Id              String?               @unique
  shippedAt           DateTime?
  deliveredAt         DateTime?
  typeSalesDelivery   TypePenjualan?        @default(null)
  staffId             String
  unitId              String
  status              DeliveryOrderStatus   @default(DRAFT)
  selectionStatus     SelectionStatus       @default(NOT_SELECTED)
  deletedAt           DateTime?
  createdAt           DateTime              @default(now())
  totalAmount         Float                 @default(0)
  Contract            Contract?
  au58                AU58?                 @relation(fields: [au58Id], references: [id])
  purchaseOrder       PurchaseOrder         @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  staff               User                  @relation(fields: [staffId], references: [id], onDelete: Cascade)
  unit                MasterUnit            @relation(fields: [unitId], references: [id])
  DeliveryOrderDetail DeliveryOrderDetail[]
  SPB                 SPB[]
  spb                 StockRequest?
}

model StockRequest {
  id              String        @id @default(uuid())
  deliveryOrderId String        @unique
  status          SPBStatus
  userId          String?
  createdAt       DateTime      @default(now())
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApprovalDocument {
  id          String          @id @default(uuid())
  approvalId  String          @unique
  documentUrl String
  deletedAt   DateTime?
  approval    ApprovalRequest @relation(fields: [approvalId], references: [id], onDelete: Cascade)
}

model MasterUnit {
  id                               String                             @id @default(uuid())
  kode                             String                             @unique
  nama                             String                             @unique
  createdAt                        DateTime                           @default(now())
  updatedAt                        DateTime                           @updatedAt
  deletedAt                        DateTime?
  bankAccount                      BankAccount[]
  Budget                           Budget[]
  cashBankTransaction              CashBankTransaction[]
  cashBankTransactionDetails       CashBankTransactionDetails[]
  deliveryOrder                    DeliveryOrder[]
  generalLedger                    GeneralLedger[]
  inventoryTransaction             InventoryTransaction[]
  inventoryTransactionBarangMentah InventoryTransactionBarangMentah[]
  invoice                          Invoice[]
